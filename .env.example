# ===========================================
# Likhitex Environment Configuration
# ===========================================
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ----- Application -----
APP_NAME=Likhitex
APP_ENV=development  # development | production
DEBUG=true
LOG_LEVEL=INFO

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_APP_NAME=Likhitex
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ----- Clerk Auth -----
# Get from: Clerk Dashboard -> your app -> API Keys
# See docs/CLERK_SETUP.md for the full walkthrough.
#
# Backend (apps/api) verifies tokens via the PUBLIC JWKS keys, so it needs no
# server-side secret. Only these two values are required.
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
# Leave EMPTY for Clerk session tokens, which carry no `aud` claim.
CLERK_AUDIENCE=
CLERK_JWKS_CACHE_SECONDS=3600
AUTH_CLOCK_SKEW_SECONDS=30

# Frontend (frontend/.env.local). Publishable key is public by design.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Only needed for Clerk server-side API calls / webhooks. The API does not use
# these today, and CLERK_SECRET_KEY is not read anywhere in apps/api/app.
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# ----- Database (Neon Postgres) -----
# Get from: https://console.neon.tech
# Use the POOLED connection string
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ----- Redis (Upstash) -----
# Get from: https://console.upstash.com
REDIS_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379

# ----- Storage (Cloudflare R2) -----
# Get from: https://dash.cloudflare.com
R2_ACCOUNT_ID=xxxxx
R2_ACCESS_KEY_ID=xxxxx
R2_SECRET_ACCESS_KEY=xxxxx
R2_BUCKET_NAME=likhitex-files
R2_PUBLIC_URL=https://xxxxx.r2.cloudflarestorage.com

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,https://likhitex.vercel.app

# ----- Security -----
SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=RS256

# ----- Rate Limiting -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_COMPILE_PER_USER=10  # per minute
RATE_LIMIT_COMPILE_GLOBAL=50    # per minute
RATE_LIMIT_UPLOAD_PER_USER=50   # per minute

# ----- Quotas -----
QUOTA_PER_USER_MB=50
QUOTA_PER_PROJECT_MB=50
QUOTA_PER_FILE_MB=10

# ----- Compile Settings -----
COMPILE_TIMEOUT_SECONDS=60
COMPILE_MAX_QUEUE_SIZE=10
COMPILE_BACKEND=local  # local | remote

# ----- Mail -----
MAIL_BACKEND=console  # console | smtp | http
MAIL_FROM=noreply@likhitex.app

# SMTP (local dev only, Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# HTTP Mail Provider (Resend for production)
RESEND_API_KEY=re_xxxxx

# ----- Sentry (Optional) -----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ----- Local Development Only -----
# Postgres for docker-compose
POSTGRES_USER=likhitex
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=likhitex
