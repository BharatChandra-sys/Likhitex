% Hardened texmf.cnf for Likhitex
% Security-focused LaTeX configuration
% Blocks shell-escape and restricts file access

% CRITICAL SECURITY SETTINGS

% Disable shell escape (prevents code execution)
shell_escape = f
shell_escape_commands =

% Paranoid file access restrictions
% 'p' = paranoid (only reads from allowed paths)
openin_any = p
openout_any = p

% Allowed read paths (colon-separated)
% Only allow reading from compile directory and TeX distribution
TEXMFOUTPUT = /compile
openin_any_path = /compile:/usr/share/texlive:/usr/share/texmf

% Block writing outside compile directory
openout_any_path = /compile

% RESOURCE LIMITS

% Max memory allocation (bytes)
main_memory = 12000000
extra_mem_bot = 10000000
font_mem_size = 8000000
pool_size = 6250000
buf_size = 200000
nest_size = 500
max_strings = 500000
param_size = 60000
save_size = 100000
stack_size = 5000

% ADDITIONAL SECURITY

% Disable mktex scripts (prevent dynamic package installation)
MKTEXTEX = 0
MKTEXPK = 0
MKTEXMF = 0
MKTEXTFM = 0
MKTEXFMT = 0

% Disable network access
TEXMFNET =

% Disable external program execution
TEXMFSCRIPTS =

% PATHS (standard TeX Live locations)

TEXMFCONFIG = ~/.texlive2023/texmf-config
TEXMFVAR = ~/.texlive2023/texmf-var
TEXMFHOME = ~/texmf
TEXMFLOCAL = /usr/local/share/texmf
TEXMFSYSCONFIG = /etc/texmf
TEXMFSYSVAR = /var/lib/texmf
TEXMFMAIN = /usr/share/texlive/texmf-dist
TEXMFDIST = /usr/share/texlive/texmf-dist

% Search path
TEXMF = {$TEXMFCONFIG,$TEXMFVAR,$TEXMFHOME,!!$TEXMFLOCAL,!!$TEXMFSYSCONFIG,!!$TEXMFSYSVAR,!!$TEXMFMAIN,!!$TEXMFDIST}

% PERFORMANCE TUNING

% Enable SyncTeX
synctex = 1

% Quiet mode (less output)
interaction = nonstopmode
